# Laptop (make up): this URL talks to compose Postgres on localhost.
DATABASE_URL=postgresql://gogo:gogo@localhost:5432/gogo

# Optional. Only needed if we ever move to Open-Meteo's paid customer endpoint.
# OPEN_METEO_API_KEY=

# --- VPS (docker-compose.prod.yml). Leave these unset on the laptop. ---
# Copy this file to .env on the host. Never commit .env.
#   openssl rand -hex 32
# POSTGRES_USER=gogo
# POSTGRES_DB=gogo
# POSTGRES_PASSWORD=
# Page only, with --profile web. Unset = site off, not open.
# GOGO_WEB_SECRET=

# Optional. `gogo health` pings this ONLY when the forecast is fresh and every spot is
# ranked, so the alarm is the ping stopping. A cron-monitor URL (healthchecks.io, Better
# Stack, Cronitor) works; the worker's healthcheck sends it every 5 minutes, so no cron
# line is needed on the box.
# GOGO_HEARTBEAT_URL=

# Optional. An rsync destination for scripts/backup.sh, so a dump also lands somewhere
# that is not this disk. Local path or user@host:/path/ — end a directory with a slash.
# GOGO_BACKUP_DEST=

# Optional. Who labels belong to until accounts land. The page and `gogo log` both read
# this, and they must agree: two handles for one person duplicate labels rather than
# colliding. Defaults to "max".
# GOGO_HANDLE=
